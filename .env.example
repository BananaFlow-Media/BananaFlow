# Copy this file to .env and fill in only the values you use.
# .env is git-ignored and must never be committed or attached to an Issue.

# YouTube Music internal browse API (optional; no committed fallback exists).
BANANAFLOW_YOUTUBE_API_KEY=

# Spotify Web API credentials (optional; app Settings remain compatible).
BANANAFLOW_SPOTIFY_CLIENT_ID=
BANANAFLOW_SPOTIFY_CLIENT_SECRET=

# Optional X-App-Token for a separately operated Spotify metadata proxy.
BANANAFLOW_SPOTIFY_APP_API_KEY=
