# ── Python bytecode and caches ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ───────────────────────────────────────────────────
venv/
.venv/
my_venv/
env/
.env

# ── Build / packaging artifacts ────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
wheels/
.eggs/

# Per-file JUnit XML, logs and the JSON aggregate written by
# scripts/run_isolated_tests.py. Regenerated by every run; CI keeps it as a
# workflow artifact instead.
test-evidence/

# Hidden per-batch download workspace (utils.paths.make_batch_workspace) —
# only ever appears if a test/dev run pointed an output_dir inside the repo.
.bananaflow_tmp/

# ── IDE / editor scratch ───────────────────────────────────────────────────
.idea/
.vscode/
.claude/
*.bak
*.swp
*~

# ── Logs and temp ──────────────────────────────────────────────────────────
*.log
*.tmp
.DS_Store
.tmp_appdata_*/

# ── Packaging outputs (regenerated by scripts/build_windows.ps1) ───────────
packaging/version_info.txt
packaging/ffmpeg/

# ── Bundled downloader components (opt-in; staged before each build — see
#    packaging/stage_pot_provider.py and packaging/runtime/README.md).
#    Only the READMEs documenting each staging slot are tracked. ───────────
packaging/yt-dlp-plugins/*
!packaging/yt-dlp-plugins/README.md
packaging/runtime/*
!packaging/runtime/README.md
packaging/pot-provider-backend/*
!packaging/pot-provider-backend/README.md
packaging/pot-provider-cache/
packaging/pot-provider-server/*
!packaging/pot-provider-server/README.md
